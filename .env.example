# .env.example - Copy this file to .env and fill in actual values

# PostgreSQL Database Configuration
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=Ghost1214
POSTGRES_DB=n8n_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# RabbitMQ Configuration
RABBITMQ_USER=n8n_rabbit
RABBITMQ_PASS=your_rabbitmq_password_here

# n8n Configuration
# Generate a random 32-character string for encryption key
N8N_ENCRYPTION_KEY=your_32_character_encryption_key_here

# AI API Keys
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_KEY=your-claude-sonnet4-api-key
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
PPLX_URL=https://api.perplexity.ai
PPLX_KEY=your-perplexity-api-key
QUSO_KEY=your-quso-ai-api-key

# MCP (Model Context Protocol) Configuration
# Unified MCP proxy settings
MCP_PROXY_URL=http://proxy:7990
MCP_PROXY_KEY=your_super_secret_jwt_key_here

# MCP Server API Keys (used during initial seed/registration)
MACROCOSMOS_KEY=your-macrocosmos-api-key
TWITTER_BEARER_TOKEN=your-twitter-bearer-token
FACEBOOK_PAGE_TOKEN=your-facebook-page-token

# Trend & Hashtag Services
RITETAG_KEY=your-ritetag-api-key
BUZZSUMO_KEY=your-buzzsumo-api-key
SERPAPI_KEY=your-serpapi-key
TRENDS_GEO=US

# Video Generation
VEO3_URL=https://api.veo3.ai
VEO3_KEY=your-veo3-api-key
REVID_KEY=your-revid-api-key
MJ_TOKEN=your-midjourney-token
# Legacy (kept for fallback)
RUNWAY_URL=https://api.runwayml.com
RUNWAY_API_KEY=your-runway-api-key

# Social Media Platform Credentials
TIKTOK_SESSION=your-tiktok-session-cookie
INSTAGRAM_ACCOUNT_ID=your-instagram-account-id
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token
LINKEDIN_PERSON_ID=your-linkedin-person-id

# Google Services
GA4_PROPERTY_ID=your-ga4-property-id
SHEETS_ID=your-master-prompt-sheets-id
SHEETS_SERVICE_CREDS={"type":"service_account","project_id":"your-project"}

# Slack Integration
# Option 1: Use webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# Option 2: Use bot token (uncomment if using)
#SLACK_TOKEN=xoxb-your-slack-bot-token

# Legacy Direct API Keys (kept for fallback if MCP proxy fails)
#TWITTER_API_KEY=your-twitter-api-key
#TWITTER_API_SECRET=your-twitter-api-secret
#TWITTER_ACCESS_TOKEN=your-twitter-access-token
#TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret

#MEDIUM_INTEGRATION_TOKEN=your-medium-integration-token

#WORDPRESS_URL=https://your-wordpress-site.com
#WORDPRESS_USERNAME=your-username
#WORDPRESS_PASSWORD=your-app-password

# Workflow Configuration
VIRAL_WEIGHTS_JSON={"engagement":0.3,"recency":0.2,"relevance":0.25,"authority":0.25}
SIMILARITY_THRESHOLD=0.8
VIRAL_THRESHOLD=60
BLOCKED_KEYWORDS=nsfw,explicit,violence,hate
MODERATION_THRESHOLD=0.7
DIGEST_RECIPIENTS=team@example.com,manager@example.com
TARGET_INDUSTRY=technology
TARGET_TIMEZONE=America/New_York
CUSTOM_TOPICS=sustainability,remote work,digital transformation
MAX_RETRIES=3

# Allowed external modules for n8n Code nodes (comma-separated)
ALLOWED_MODULES=axios,lodash,moment,@tensorflow/tfjs

# n8n Queue Mode Configuration (for high-volume processing)
# Required for ViralHub orchestrator
EXECUTIONS_PROCESS=main
EXECUTIONS_MODE=queue
QUEUE_BULL_REDIS_HOST=redis
QUEUE_BULL_REDIS_PORT=6379

# Cost Monitoring
DAILY_BUDGET=50.00
COST_ALERT_THRESHOLD=0.8

# Optional n8n Configuration
#N8N_BASIC_AUTH_USER=admin
#N8N_BASIC_AUTH_PASSWORD=admin_password
#WEBHOOK_URL=https://your-domain.com/
#N8N_HOST=localhost
#N8N_PORT=5678
#N8N_PROTOCOL=http
N8N_PERSONALIZATION_ENABLED=false

# Monitoring & Alerting
PAGERDUTY_API_KEY=your-pagerduty-api-key
SENTRY_DSN=your-sentry-dsn

# Vector Log Processing
VECTOR_LOG_LEVEL=info

# Timezone
TZ=America/New_York