      "id": "openai-generate",
      "name": "Generate with OpenAI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1550, 200]
    },
    {
      "parameters": {
        "functionCode": "// Enhanced viral scoring and moderation with MCP awareness\nconst content = $json.choices?.[0]?.message?.content || \"\";\nconst originalData = $node[\"Content Aggregator\"].json;\n\nlet viralScore = 0;\nlet moderationIssues = [];\nlet useFallback = false;\n\n// Viral scoring logic\nif (content.length >= 80 && content.length <= 280) {\n  viralScore += 30;\n}\nif (content.includes('?')) {\n  viralScore += 20;\n}\nconst emojiCount = (content.match(/[\\u{1F600}-\\u{1F64F}]/gu) || []).length;\nviralScore += Math.min(emojiCount * 10, 25);\n\n// Hashtag scoring\nconst hashtagCount = (content.match(/#\\w+/g) || []).length;\nif (hashtagCount >= 1 && hashtagCount <= 3) {\n  viralScore += 15;\n}\n\n// Source-based scoring bonus\nif (originalData.source === 'macrocosmos') {\n  viralScore += 10; // Bonus for curated content\n}\n\n// Moderation checks\nconst sensitiveTerms = ['violence', 'hate', 'explicit', 'controversial'];\nconst contentLower = content.toLowerCase();\nsensitiveTerms.forEach(term => {\n  if (contentLower.includes(term)) {\n    moderationIssues.push(term);\n    useFallback = true;\n  }\n});\n\n// Platform-specific checks\nconst targetPlatforms = ['twitter', 'facebook', 'slack'];\nconst platformRequirements = {\n  twitter: { maxLength: 280, hashtagLimit: 5 },\n  facebook: { maxLength: 63206, hashtagLimit: 30 },\n  slack: { maxLength: 4000, hashtagLimit: 10 }\n};\n\n// Check if content is too short or failed generation\nif (content.length < 50 || !content) {\n  useFallback = true;\n}\n\nreturn [{\n  content,\n  useFallback,\n  viralScore: Math.min(viralScore, 100),\n  moderationIssues,\n  originalContent: originalData.content,\n  sourceUrl: originalData.url,\n  targetPlatforms,\n  platformRequirements\n}];"
      },
      "id": "viral-score-moderation",
      "name": "Viral Score & Moderation",
