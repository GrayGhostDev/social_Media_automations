      "parameters": {
        "functionCode": "// Build search keywords based on time of day and trends\nconst now = new Date();\nconst hour = now.getHours();\nlet terms = [];\n\n// Time-based topic selection\nif (hour >= 6 && hour < 12) {\n  terms = ['morning routine', 'productivity tips', 'breakfast ideas'];\n} else if (hour >= 12 && hour < 17) {\n  terms = ['lunch break', 'afternoon motivation', 'work tips'];\n} else if (hour >= 17 && hour < 22) {\n  terms = ['evening relaxation', 'dinner ideas', 'entertainment'];\n} else {\n  terms = ['late night thoughts', 'insomnia tips', 'midnight snacks'];\n}\n\n// Return multiple items for parallel processing\nreturn terms.map(term => ({\n  json: { \n    term,\n    timestamp: now.toISOString(),\n    searchType: 'trending'\n  }\n}));"
      },
