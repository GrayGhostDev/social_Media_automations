              "value": "={{ [{\"role\": \"user\", \"content\": \"Please rewrite the following content to be engaging but also highly appropriate and compliant with all content policies. Make it shareable and add appropriate emojis. Target platforms: \" + $json.targetPlatforms.join(', ') + \". Original: \" + $json.originalContent}] }}"
