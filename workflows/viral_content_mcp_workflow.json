    {
      "parameters": {
        "functionCode": "// Aggregate and score content from multiple sources\nconst allContent = [];\n\n// Process each item\nfor (const item of $input.all()) {\n  const json = item.json;\n  \n  // Extract content based on source\n  if (json.results) { // Macrocosmos\n    json.results.forEach(r => {\n      allContent.push({\n        content: r.text || r.title,\n        source: 'macrocosmos',\n        engagement: r.score || 0,\n        url: r.url\n      });\n    });\n  } else if (json.tweets) { // Twitter\n    json.tweets.forEach(t => {\n      allContent.push({\n        content: t.text,\n        source: 'twitter',\n        engagement: t.retweet_count + t.favorite_count,\n        url: t.url\n      });\n    });\n  } else if (json.content) { // Legacy\n    allContent.push({\n      content: json.content,\n      source: 'legacy',\n      engagement: json.engagement || 0,\n      url: json.url\n    });\n  }\n}\n\n// Sort by engagement and take top 5\nconst topContent = allContent\n  .sort((a, b) => b.engagement - a.engagement)\n  .slice(0, 5);\n\n// Return the best content piece\nreturn [{\n  json: topContent[0] || { content: 'No viral content found', source: 'default' }\n}];"
      },
      "id": "content-aggregator",
      "name": "Content Aggregator",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1350, 200]
