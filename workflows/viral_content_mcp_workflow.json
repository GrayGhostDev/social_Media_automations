      "id": "anthropic-generate",
      "name": "Generate with Anthropic",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [2150, 300]
    },
    {
      "parameters": {
        "functionCode": "// MCP Router - determines which endpoints to call based on platforms\nconst content = $json.content || $json.content?.[0]?.text || '';\nconst platforms = $json.targetPlatforms || ['slack'];\nconst viralScore = $json.viralScore || 0;\n\nconst platformEndpoints = {\n  twitter: '/twitter-mcp/create_post',\n  facebook: '/facebook/post_to_facebook',\n  slack: 'direct', // Use direct webhook, not MCP\n  medium: '/medium-mcp/publish',\n  linkedin: '/linkedin-mcp/share'\n};\n\n// Create publishing tasks for each platform\nconst publishingTasks = platforms.map(platform => {\n  const endpoint = platformEndpoints[platform];\n  \n  // Platform-specific content formatting\n  let formattedContent = content;\n  if (platform === 'twitter' && content.length > 280) {\n    formattedContent = content.substring(0, 277) + '...';\n  }\n  \n  return {\n    platform,\n    endpoint,\n    content: formattedContent,\n    viralScore,\n    useMcp: endpoint !== 'direct',\n    metadata: {\n      sourceUrl: $json.sourceUrl,\n      generatedAt: new Date().toISOString()\n    }\n  };\n});\n\n// Return tasks as separate items for parallel processing\nreturn publishingTasks.map(task => ({ json: task }));"
      },
