        },
        "sendBody": true,
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "model",
              "value": "gpt-3.5-turbo"
            },
            {
              "name": "messages",
              "value": "={{ [{\"role\": \"system\", \"content\": \"You are a viral content creator. Rewrite content to be engaging, shareable, and optimized for social media. Keep it concise (under 280 chars for Twitter). Add relevant emojis and hashtags.\"}, {\"role\": \"user\", \"content\": \"Rewrite this for maximum engagement: \" + $json.content}] }}"
            },
