    {
      "id": "requeue",
      "name": "Requeue with Delay",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "parameters": {
        "functionCode": "// Add retry metadata and delay\nconst retryCount = items[0].json.retry_count || 0;\nconst maxRetries = parseInt($vars.MAX_RETRIES || '3');\n\nif (retryCount >= maxRetries) {\n  // Max retries reached, send to error handler\n  items[0].json.failed = true;\n  items[0].json.failure_reason = 'Max retries exceeded';\n  items[0].json.last_error = $node['Platform Upload'].error || 'Unknown error';\n  return items;\n}\n\n// Calculate exponential backoff\nconst baseDelay = 60000; // 1 minute\nconst delay = baseDelay * Math.pow(2, retryCount);\n\nitems[0].json.retry_count = retryCount + 1;\nitems[0].json.retry_at = new Date(Date.now() + delay).toISOString();\nitems[0].json.last_attempt = new Date().toISOString();\nitems[0].json.last_error = $node['Platform Upload'].error || 'Upload failed';\n\nreturn items;"
      },
      "position": [2080, 500]
    },
