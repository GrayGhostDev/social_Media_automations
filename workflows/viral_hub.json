    {
      "id": "keywords",
      "name": "Keyword Builder",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "parameters": {
        "functionCode": "// Build keyword seeds based on industry and trends\nconst industries = [\n  { name: 'technology', keywords: ['AI', 'automation', 'cloud', 'cybersecurity'] },\n  { name: 'health', keywords: ['wellness', 'fitness', 'nutrition', 'mental health'] },\n  { name: 'business', keywords: ['startup', 'productivity', 'leadership', 'growth'] },\n  { name: 'finance', keywords: ['crypto', 'investing', 'budgeting', 'stocks'] }\n];\n\nconst selectedIndustry = $vars.TARGET_INDUSTRY || 'technology';\nconst industry = industries.find(i => i.name === selectedIndustry) || industries[0];\n\n// Generate keyword combinations\nconst seeds = [];\nconst platforms = ['tiktok', 'instagram', 'twitter', 'linkedin'];\n\nindustry.keywords.forEach(keyword => {\n  platforms.forEach(platform => {\n    seeds.push({\n      json: {\n        idea: keyword,\n        industry: industry.name,\n        platform: platform,\n        research_type: 'Trending_Topics',\n        timestamp: new Date().toISOString(),\n        source: 'keyword_builder'\n      }\n    });\n  });\n});\n\n// Add custom topics from env if available\nif ($vars.CUSTOM_TOPICS) {\n  const customTopics = $vars.CUSTOM_TOPICS.split(',');\n  customTopics.forEach(topic => {\n    platforms.forEach(platform => {\n      seeds.push({\n        json: {\n          idea: topic.trim(),\n          industry: 'custom',\n          platform: platform,\n          research_type: 'Trending_Topics',\n          timestamp: new Date().toISOString(),\n          source: 'custom_topics'\n        }\n      });\n    });\n  });\n}\n\nreturn seeds;"
      },
      "position": [680, 140]
    },
    {
      "id": "execResearch",
      "name": "Execute Research",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "parameters": {
        "workflowId": "ResearchFetcher",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "position": [900, 140]
    },
    {
      "id": "viralScore",
      "name": "Viral Score Calculator",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "parameters": {
        "functionCode": "// Calculate viral score with enhanced algorithm\nconst viralScore = require('/home/node/.n8n/custom/functions/viralScore.js');\n\nitems.forEach(item => {\n  const content = item.json.research_data?.trends?.[0]?.topic || item.json.idea;\n  const platform = item.json.platform;\n  \n  // Calculate score\n  const scoreResult = viralScore.calculateViralScore(content, {\n    engagement: item.json.research_data?.trends?.[0]?.score || 0,\n    platform: platform,\n    hashtags: item.json.research_data?.keywords || [],\n    weights: JSON.parse($vars.VIRAL_WEIGHTS_JSON || '{}')\n  });\n  \n  // Enrich item with score\n  item.json.viral_score = scoreResult.score;\n  item.json.viral_potential = scoreResult.isViral;\n  item.json.viral_recommendation = scoreResult.recommendation;\n  \n  // Add timestamp for deduplication\n  item.json.scored_at = Date.now();\n});\n\n// Filter out low-scoring items\nconst threshold = parseFloat($vars.VIRAL_THRESHOLD || '60');\nreturn items.filter(item => item.json.viral_score >= threshold);"
      },
      "position": [1140, 140]
    },
    {
      "id": "dedupe",
      "name": "Deduplication Filter",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "parameters": {
        "functionCode": "// Deduplicate based on content similarity\nconst deduplication = require('/home/node/.n8n/custom/functions/deduplication.js');\n\n// Get recent posts from global cache\nconst recentPosts = global.recentPosts || [];\nconst similarityThreshold = parseFloat($vars.SIMILARITY_THRESHOLD || '0.8');\n\nconst uniqueItems = [];\nconst duplicates = [];\n\nitems.forEach(item => {\n  const content = item.json.idea || item.json.research_data?.trends?.[0]?.topic || '';\n  const isDuplicate = deduplication.checkDuplicate(content, recentPosts, similarityThreshold);\n  \n  if (!isDuplicate.isDuplicate) {\n    uniqueItems.push(item);\n    // Add to recent posts cache\n    recentPosts.push({\n      content: content,\n      hash: isDuplicate.hash,\n      platform: item.json.platform,\n      timestamp: Date.now()\n    });\n  } else {\n    duplicates.push({\n      ...item,\n      json: {\n        ...item.json,\n        duplicate_of: isDuplicate.matchedHash,\n        similarity_score: isDuplicate.similarityScore\n      }\n    });\n  }\n});\n\n// Update global cache (keep last 1000 posts)\nglobal.recentPosts = recentPosts.slice(-1000);\n\n// Log duplicates for analytics\nif (duplicates.length > 0) {\n  console.log(`Filtered ${duplicates.length} duplicate items`);\n}\n\nreturn uniqueItems;"
      },
      "position": [1340, 140]
    },
