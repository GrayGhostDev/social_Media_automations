      "parameters": {
        "functionCode": "// Generate trending search terms based on time and context\nconst terms = [];\nconst now = new Date();\nconst hour = now.getHours();\nconst day = now.getDay();\n\n// Time-based topics\nif (hour >= 6 && hour < 10) {\n  terms.push('morning routine', 'productivity tips', 'breakfast ideas');\n} else if (hour >= 10 && hour < 14) {\n  terms.push('work hacks', 'lunch ideas', 'midday motivation');\n} else if (hour >= 14 && hour < 18) {\n  terms.push('afternoon energy', 'quick tips', 'life hacks');\n} else if (hour >= 18 && hour < 22) {\n  terms.push('evening routine', 'dinner recipes', 'relaxation');\n} else {\n  terms.push('night owl', 'late night thoughts', 'insomnia tips');\n}\n\n// Day-based topics\nif (day === 1) terms.push('monday motivation', 'week planning');\nif (day === 5) terms.push('friday feeling', 'weekend plans');\nif (day === 0 || day === 6) terms.push('weekend vibes', 'self care');\n\n// Seasonal/trending\nterms.push('AI tools', 'sustainability', 'mental health');\n\nreturn terms.slice(0, 5).map(term => ({ json: { term, timestamp: now.toISOString() } }));"
      },
