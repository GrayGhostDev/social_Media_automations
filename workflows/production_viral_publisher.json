      "parameters": {
        "functionCode": "// Viral Score Calculator with weighted factors\nconst weights = JSON.parse($env.VIRAL_WEIGHTS_JSON || '{\"engagement\":0.3,\"recency\":0.2,\"relevance\":0.25,\"authority\":0.25}');\n\nfunction calculateScore(item) {\n  let score = 0;\n  \n  // Engagement score (likes, shares, comments)\n  const engagement = item.likes || item.retweets || item.score || 0;\n  score += Math.min(engagement / 1000, 1) * weights.engagement * 100;\n  \n  // Recency score\n  const ageHours = item.timestamp ? \n    (new Date() - new Date(item.timestamp)) / (1000 * 60 * 60) : 24;\n  const recencyScore = Math.max(1 - (ageHours / 168), 0); // 1 week decay\n  score += recencyScore * weights.recency * 100;\n  \n  // Relevance score (keyword matching)\n  const term = item.term || '';\n  const content = (item.content || item.title || '').toLowerCase();\n  const relevance = content.includes(term.toLowerCase()) ? 1 : 0.5;\n  score += relevance * weights.relevance * 100;\n  \n  // Authority score (source credibility)\n  const authorityMap = {\n    'macrocosmos': 0.9,\n    'buzzsumo': 0.85,\n    'google_trends': 0.8,\n    'ritetag': 0.75,\n    'sheets': 0.7,\n    'default': 0.5\n  };\n  const authority = authorityMap[item.source] || authorityMap.default;\n  score += authority * weights.authority * 100;\n  \n  return Math.round(Math.min(score, 100));\n}\n\n// Process all items\nreturn $input.all().map(item => {\n  const viralScore = calculateScore(item.json);\n  return {\n    json: {\n      ...item.json,\n      viral_score: viralScore,\n      viral_tier: viralScore >= 80 ? 'hot' : viralScore >= 60 ? 'warm' : 'cold'\n    }\n  };\n});"
      },
      "id": "node-8",
      "name": "Viral Score Calculator",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "functionCode": "// Deduplication based on content similarity\nconst threshold = parseFloat($env.SIMILARITY_THRESHOLD || '0.8');\nconst seen = new Map();\n\nfunction similarity(str1, str2) {\n  const s1 = str1.toLowerCase();\n  const s2 = str2.toLowerCase();\n  \n  // Simple Jaccard similarity\n  const words1 = new Set(s1.split(/\\s+/));\n  const words2 = new Set(s2.split(/\\s+/));\n  \n  const intersection = new Set([...words1].filter(x => words2.has(x)));\n  const union = new Set([...words1, ...words2]);\n  \n  return intersection.size / union.size;\n}\n\nconst unique = [];\n\nfor (const item of $input.all()) {\n  const content = item.json.content || item.json.title || '';\n  let isDuplicate = false;\n  \n  for (const [key, existing] of seen) {\n    if (similarity(content, existing) >= threshold) {\n      isDuplicate = true;\n      break;\n    }\n  }\n  \n  if (!isDuplicate) {\n    seen.set(content, content);\n    unique.push(item);\n  }\n}\n\nreturn unique;"
      },
