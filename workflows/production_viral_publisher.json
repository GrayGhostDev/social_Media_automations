        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"dateRanges\": [{\n    \"startDate\": \"yesterday\",\n    \"endDate\": \"today\"\n  }],\n  \"dimensions\": [{\n    \"name\": \"pagePath\"\n  }],\n  \"metrics\": [{\n    \"name\": \"screenPageViews\"\n  }, {\n    \"name\": \"totalUsers\"\n  }]\n} }}"
      },
      "id": "node-30",
      "name": "GA4 Collector",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [300, 1600]
    },
    {
      "parameters": {
        "functionCode": "// Fetch insights from multiple platforms\nconst platforms = ['facebook', 'instagram', 'tiktok', 'linkedin'];\nconst insights = [];\n\nfor (const platform of platforms) {\n  insights.push({\n    json: {\n      platform,\n      fetch_endpoint: `${platform}_insights`,\n      timestamp: new Date().toISOString()\n    }\n  });\n}\n\nreturn insights;"
      },
      "id": "node-31",
      "name": "Platform Insights Fetcher",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [500, 1600]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "node-32",
      "name": "A/B Splitter",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1300, 700]
    },
    {
      "parameters": {
        "functionCode": "// Compare A/B test variants after 24 hours\nconst variantA = $json.variant_a_metrics;\nconst variantB = $json.variant_b_metrics;\n\nconst winner = variantA.ctr > variantB.ctr ? 'A' : 'B';\nconst uplift = Math.abs(variantA.ctr - variantB.ctr) / Math.min(variantA.ctr, variantB.ctr) * 100;\n\nreturn [{\n  json: {\n    winner,\n    uplift_percentage: uplift,\n    variant_a_ctr: variantA.ctr,\n    variant_b_ctr: variantB.ctr,\n    recommendation: `Use variant ${winner} for future posts`\n  }\n}];"
      },
      "id": "node-33",
      "name": "Variant Comparator",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [700, 1600]
    },
    {
      "parameters": {
        "functionCode": "// Virality Predictor using simple heuristics\n// In production, this would load a TensorFlow.js model\n\nconst features = {\n  hour_of_day: new Date().getHours(),\n  day_of_week: new Date().getDay(),\n  content_length: ($json.content || '').length,\n  hashtag_count: ($json.content.match(/#/g) || []).length,\n  emoji_count: ($json.content.match(/[\\u{1F600}-\\u{1F64F}]/gu) || []).length,\n  question_mark: $json.content.includes('?') ? 1 : 0,\n  exclamation: $json.content.includes('!') ? 1 : 0,\n  viral_score: $json.viral_score || 0\n};\n\n// Simple prediction model (replace with actual TF.js model)\nlet predicted_virality = 0;\npredicted_virality += features.viral_score * 0.3;\npredicted_virality += (features.emoji_count > 0 ? 10 : 0);\npredicted_virality += (features.question_mark ? 15 : 0);\npredicted_virality += (features.hashtag_count >= 3 && features.hashtag_count <= 5 ? 10 : 0);\npredicted_virality += (features.hour_of_day >= 12 && features.hour_of_day <= 14 ? 5 : 0);\npredicted_virality += (features.hour_of_day >= 19 && features.hour_of_day <= 21 ? 10 : 0);\n\nreturn [{\n  json: {\n    predicted_virality: Math.min(predicted_virality, 100),\n    confidence: 0.75,\n    features,\n    recommendation: predicted_virality >= 70 ? 'high_potential' : 'normal'\n  }\n}];"
      },
      "id": "node-34",
      "name": "Virality Predictor",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [900, 1600]
    },
    {
      "parameters": {
        "functionCode": "// Optimize prompts based on performance data\nconst performance = $json.platform_performance || {};\nconst current_weights = JSON.parse($env.VIRAL_WEIGHTS_JSON || '{}');\n\n// Adjust weights based on performance\nconst new_weights = { ...current_weights };\n\nif (performance.engagement_rate > 0.05) {\n  new_weights.engagement *= 1.1;\n}\nif (performance.click_rate > 0.02) {\n  new_weights.relevance *= 1.1;\n}\n\n// Normalize weights\nconst sum = Object.values(new_weights).reduce((a, b) => a + b, 0);\nObject.keys(new_weights).forEach(key => {\n  new_weights[key] = new_weights[key] / sum;\n});\n\nreturn [{\n  json: {\n    updated_weights: new_weights,\n    performance_summary: performance,\n    optimization_applied: true\n  }\n}];"
      },
      "id": "node-35",
      "name": "Prompt Optimizer",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1100, 1600]
    },
    {
      "parameters": {
        "html": "=<h2>Daily Performance Digest</h2>\n<p>Date: {{$now.format('YYYY-MM-DD')}}</p>\n\n<h3>Publishing Summary</h3>\n<table border=\"1\" style=\"border-collapse: collapse; width: 100%;\">\n  <tr>\n    <th>Platform</th>\n    <th>Posts</th>\n    <th>Avg Engagement</th>\n    <th>Best Performing</th>\n  </tr>\n  {{#each $json.platform_stats}}\n  <tr>\n    <td>{{platform}}</td>\n    <td>{{post_count}}</td>\n    <td>{{engagement_rate}}%</td>\n    <td>{{best_post_id}}</td>\n  </tr>\n  {{/each}}\n</table>\n\n<h3>A/B Test Results</h3>\n<p>Winner: Variant {{$json.ab_test_winner}}</p>\n<p>Uplift: {{$json.ab_uplift}}%</p>\n\n<h3>AI Model Performance</h3>\n<ul>\n  <li>GPT-4: {{$json.model_stats.gpt4_usage}} uses</li>\n  <li>Claude: {{$json.model_stats.claude_usage}} uses</li>\n  <li>Gemini: {{$json.model_stats.gemini_usage}} uses</li>\n</ul>\n\n<h3>Recommendations</h3>\n<ul>\n  {{#each $json.recommendations}}\n  <li>{{this}}</li>\n  {{/each}}\n</ul>"
      },
