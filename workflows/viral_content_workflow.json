            {
              "name": "messages",
              "value": "={{ [{\"role\": \"system\", \"content\": \"You are a viral content creator. Rewrite content to be engaging, shareable, and optimized for social media. Keep it concise and add relevant emojis.\"}, {\"role\": \"user\", \"content\": \"Rewrite this for maximum engagement: \" + $json.content}] }}"
