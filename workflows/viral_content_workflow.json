      "id": "a1b2c3d4-6c7d-6e5f-bg4h-3c4d5e6f7g8h",
      "name": "Generate with OpenAI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "functionCode": "// Import custom functions (if NODE_FUNCTION_ALLOW_EXTERNAL is set)\n// const { calculateViralScore } = require('/home/node/.n8n/custom/functions/viralScore.js');\n// const { moderateContent } = require('/home/node/.n8n/custom/functions/contentModeration.js');\n\n// For now, implement inline for compatibility\nconst content = $json.choices?.[0]?.message?.content || \"\";\nlet useFallback = false;\nlet viralScore = 0;\nlet moderationIssues = [];\n\n// Simple viral scoring\nif (content.length >= 80 && content.length <= 280) {\n  viralScore += 30;\n}\nif (content.includes('?')) {\n  viralScore += 20;\n}\nif (content.match(/[\\u{1F600}-\\u{1F64F}]/gu)) {\n  viralScore += 25;\n}\n\n// Simple moderation check\nconst sensitiveTerms = ['violence', 'hate', 'explicit'];\nconst contentLower = content.toLowerCase();\nsensitiveTerms.forEach(term => {\n  if (contentLower.includes(term)) {\n    moderationIssues.push(term);\n    useFallback = true;\n  }\n});\n\n// Check if content is too short or failed generation\nif (content.length < 50 || !content) {\n  useFallback = true;\n}\n\nreturn [{\n  content,\n  useFallback,\n  viralScore,\n  moderationIssues,\n  originalContent: $node[\"Fetch Trending Content\"].json.content\n}];"
      },
      "id": "b2c3d4e5-7d8e-7f6g-ch5i-4d5e6f7g8h9i",
