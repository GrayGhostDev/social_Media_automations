      "id": "8",
      "name": "Load Input Templates",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [650, 600],
      "credentials": {
        "googleSheetsOAuth2": {
          "id": "gsheets_cred",
          "name": "Google Sheets Account"
        }
      }
